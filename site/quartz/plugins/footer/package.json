    "defaultOrder": 100,
    "defaultEnabled": true,
    "components": {
      "Footer": {
        "displayName": "Footer",
        "description": "The garden's own footer: the links out, no generator credit",
        "defaultPosition": "footer",
        "defaultPriority": 50
      }
    }
