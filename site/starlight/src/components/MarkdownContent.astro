---
// The chapter's receipt (journey-site#142; Joe, 2026-09-20; the slot settled by the crew: the FOOT).
// `evidence:` is the one sanitised line that proved the night -- the query, the rule, the number --
// told in the tray brief and copied by the chronicler character for character; `evidence_caption:`
// is her one sentence saying what it shows. A chapter is a story: house-acts opens on the night,
// and the reader who scored the book 7 in round 3 got there by reading to the end, so the receipt
// is the epilogue's shape -- the night told, then the one line that proved it, above and apart
// from Starlight's prev/next, which is chrome. (A garden page is a claim and leads with its
// receipt; the same figure, the other end.) The pair is read here without re-validating: the
// gate is src/evidence.ts, run from routeData.ts on every page (#145, Bilby).
//
// This is a Starlight component override wrapping the default: the body renders exactly as it did,
// and the figure follows it inside the same article. A value she quotes in `backticks` inside the
// caption renders as code (cold read 6 saw the raw backticks); the same split as the garden's
// codeSpans(), and nothing else in the caption is markup.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { evidenceOf } from '../evidence';
import { castOf, withCast } from '../cast';

const { entry } = Astro.locals.starlightRoute;
const receipt = evidenceOf(entry.id, entry.data as { evidence?: unknown; evidence_caption?: unknown });
// The door's cast key (journey-site#459) goes after the body's first paragraph -- the identity line --
// so the body is rendered to a string once, on the door only, when it carries a cast. Every other
// page takes the slot path exactly as before.
const cast = castOf(entry.id, entry.data as { cast?: { name: string; role: string }[] });
const body = cast ? withCast(await Astro.slots.render('default'), cast) : undefined;
---

{body !== undefined ? <Default {...Astro.props}><Fragment set:html={body} /></Default> : <Default {...Astro.props}><slot /></Default>}
{receipt && (
	<figure class="book-evidence">
		<pre><code>{receipt.line}</code></pre>
		<figcaption>{receipt.caption.split(/`([^`\n]+)`/).map((part, i) => (i % 2 ? <code>{part}</code> : part))}</figcaption>
		{receipt.note && <p class="book-evidence-note">{receipt.note}</p>}
	</figure>
)}
