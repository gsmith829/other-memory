---
// The spine, shelved (journey-site#95; Joe, 2026-09-19). The chronicle's chapters are grouped by
// SHELVES OF TWENTY ACT NUMBERS -- "Acts 1–20", "Acts 21–40" -- from the `act:` every chapter
// already carries (the Narrative's number, #81). Not by month: a month is whatever size the
// record made it (~40 Acts at the Narrative's pace) and would reproduce the flat list. Empty
// shelves are not rendered (today: one shelf, holding 15 and 18); the newest shelf is open, older
// ones collapsed; the width is the one constant below, so regrouping later costs nothing.
//
// This is a Starlight component override (astro.config.mjs `components`, on #77's allow-list).
// It reads the sidebar Starlight already built from the config -- the config's sidebar structure
// is untouched -- and regroups the chronicle's links; then renders with Starlight's own
// SidebarSublist so the identity stylesheet's rules apply unchanged. The front door stays first,
// unshelved; the links out (Other Memory ↗, Colophon) stay where the config puts them.
//
// A chapter with no `act:` FAILS THE BUILD, naming the file -- the same strength of control as the
// garden's `topic:` (#96): both are fields told in the tray brief, copied never derived, and D17
// says every chapter carries the Narrative's number (#81). A warning that ships was the first cut;
// Bilby's review of #97 asked for parity and Joe chose `fail` (2026-09-19). Site template, not content.
import { getCollection } from 'astro:content';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import type { SidebarEntry } from '@astrojs/starlight/utils/routing/types';

/** Acts per shelf. */
const SHELF = 20;
/** The chronicle: content/awakening/ -> /awakening/... */
const CHRONICLE = '/awakening/';

type Link = Extract<SidebarEntry, { type: 'link' }>;
type Group = Extract<SidebarEntry, { type: 'group' }>;

const docs = await getCollection('docs');
const actByHref = new Map<string, number | undefined>();
const dateByHref = new Map<string, number>();
for (const d of docs) {
  actByHref.set(`/${d.id}/`, d.data.act);
  dateByHref.set(`/${d.id}/`, d.data.date ? new Date(d.data.date).getTime() : 0);
}

const shelfOf = (act: number) => Math.floor((act - 1) / SHELF);
const shelfLabel = (i: number) => `Acts ${i * SHELF + 1}–${(i + 1) * SHELF}`;

function shelve(links: Link[]): SidebarEntry[] {
  // ASSUMPTION, not a guarantee: the group's first link is the front door. True because Starlight's
  // autogenerate puts the folder's index.md first (measured at 0.42.1); if the index ever moves or is
  // renamed, the door would be shelved by its (absent) act: and the throw below names it.
  const [door, ...chapters] = links;
  const shelves = new Map<number, Link[]>();
  for (const l of chapters) {
    const act = actByHref.get(l.href);
    if (typeof act !== 'number') {
      throw new Error(`[sidebar] ${l.href} has no act: -- every chapter carries the Narrative's Act number (journey-site#81); add it to the tray brief's pieces: and rebuild`);
    }
    (shelves.get(shelfOf(act)) ?? shelves.set(shelfOf(act), []).get(shelfOf(act))!).push(l);
  }
  const indices = [...shelves.keys()].sort((a, b) => a - b);
  const newest = indices[indices.length - 1];
  const oldest = indices[0];
  const out: SidebarEntry[] = door ? [door] : [];
  // Cold reads 3 and 4 (journey-site#140, #189; Joe, 2026-09-21): on the DOOR every shelf is open --
  // a chronicle whose table of contents is behind a chevron loses the ninety-second reader, and at
  // this size the whole spine fits a laptop fold. Inside a chapter the older shelves fold as before,
  // and Starlight's persister keeps whatever the reader did. An EMPTY shelf between two filled ones
  // ("no 41-60, and 61-80 holds one item ... the empty band still reads as a bug", two rounds
  // running) is rendered as a muted label with no caret and nothing under it, so the gap is stated
  // where it is seen instead of explained on the door: a group with no entries and a badge that
  // custom.css turns into the words "not yet told". Never before the first shelf or after the last.
  for (let i = oldest; i <= newest; i++) {
    const links = shelves.get(i);
    if (!links) {
      out.push({ type: 'group', label: shelfLabel(i), entries: [], collapsed: true, badge: { text: 'not yet told', variant: 'default', class: 'book-shelf-empty' } } as Group);
      continue;
    }
    const sorted = links.sort((a, b) => (actByHref.get(a.href)! - actByHref.get(b.href)!) || (dateByHref.get(a.href)! - dateByHref.get(b.href)!) || a.href.localeCompare(b.href));
    out.push({ type: 'group', label: shelfLabel(i), entries: nightly(sorted), collapsed: !isDoor && i !== newest, badge: undefined } as Group);
  }
  return out;
}

// An Act with more than one chapter (journey-site#129; Joe, 2026-09-20): the chapters sit under one
// label, "Act 22", in date order -- the spine shows that a night has more than one chapter without
// numbering the parts. No "Part I / II": position inside an Act is what house-acts forbids, and two
// of the three cases as published are parallel threads of one night with no order between them.
//
// An Act with one chapter carries its number too (Joe, 2026-09-20, after cold read round 3: a
// stranger could not tell Shadow Zone was Act 18 from the spine once the doubled Acts said "Act 4"
// beside it; Acts, not dates -- dates would clutter). It rides on Starlight's own link `badge` --
// a <span class="sl-badge book-act-badge"> after the title -- and custom.css turns that into the
// mono eyebrow ABOVE the title, the same voice as the page's own "Act 18". No custom renderer.
// This is not #83's per-site count coming back: it is the Narrative's number, and it skips.
function nightly(sorted: Link[]): SidebarEntry[] {
  const out: SidebarEntry[] = [];
  let i = 0;
  while (i < sorted.length) {
    const act = actByHref.get(sorted[i].href)!;
    let j = i;
    while (j < sorted.length && actByHref.get(sorted[j].href) === act) j++;
    const run = sorted.slice(i, j);
    if (run.length === 1) out.push({ ...run[0], badge: { text: `Act ${act}`, variant: 'default', class: 'book-act-badge' } } as Link);
    else out.push({ type: 'group', label: `Act ${act}`, entries: run, collapsed: false, badge: undefined } as Group);
    i = j;
  }
  return out;
}

const { sidebar, entry } = Astro.locals.starlightRoute;
/** The front door is the folder's index: every shelf opens there (see shelve). */
const isDoor = entry.id === CHRONICLE.replaceAll('/', '');
const shelved: SidebarEntry[] = sidebar.map((entry) => {
  if (entry.type !== 'group') return entry;
  const links = entry.entries.filter((e): e is Link => e.type === 'link');
  if (!links.length || !links.every((l) => l.href.startsWith(CHRONICLE))) return entry;
  return { ...entry, entries: shelve(links) };
});
---

<SidebarPersister>
	<SidebarSublist sublist={shelved} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
